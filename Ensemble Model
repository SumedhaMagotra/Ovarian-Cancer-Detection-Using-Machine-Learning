from tensorflow.keras.models import Model, load_model
from tensorflow.keras.layers import Input, Average

model_1 = load_model("/content/drive/MyDrive/model1.keras")
model_1 = Model(inputs = model_1.inputs,
                outputs = model_1.outputs,
                name = 'model1')
model_2 = load_model("/content/drive/My Drive/model2.keras")
model_2 = Model(inputs = model_2.inputs,
                outputs = model_2.outputs,
                name = 'model2')
models = [model_1,model_2]
model_input = Input(shape = (224,224,3))
model_outputs = [model(model_input) for model in models]
if any(isinstance(output, list) for output in model_outputs):
    model_outputs = [tensor for sublist in model_outputs for tensor in sublist]  # Flatten

# Merge outputs using Average()
ensemble_output = Average()(model_outputs)  # Corrected spelling

# Create the ensemble model
ensemble_model = Model(inputs=model_input, outputs=ensemble_output, name='ensemble')

# Print model summary to verify structure
ensemble_model.summary()
ensemble_model.compile(optimizer='adam',loss = tf.losses.SparseCategoricalCrossentropy(from_logits=False),metrics=['accuracy'])
history = ensemble_model.fit(
    train_ds,
    validation_data = val_ds,
    epochs = 5,callbacks = [checkpoint]
)

