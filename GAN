# Function to load and preprocess images
def load_and_preprocess(input_path, target_path):
    input_image = tf.io.read_file(input_path)
    input_image = tf.image.decode_jpeg(input_image, channels=3)
    input_image = tf.image.resize(input_image, (256, 256))

    target_image = tf.io.read_file(target_path)
    target_image = tf.image.decode_jpeg(target_image, channels=3)
    target_image = tf.image.resize(target_image, (256, 256))

    # Normalize images to [-1,1]
    input_image = (tf.cast(input_image, tf.float32) / 127.5) - 1
    target_image = (tf.cast(target_image, tf.float32) / 127.5) - 1

    return input_image, target_image

# Create dataset with paired images
dataset = tf.data.Dataset.from_tensor_slices((non_cancer_paths, cancer_paths))
dataset = dataset.map(load_and_preprocess, num_parallel_calls=tf.data.AUTOTUNE)
