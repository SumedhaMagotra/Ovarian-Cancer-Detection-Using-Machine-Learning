# Pix2Pix Generator
def pix2pix_generator():
    inputs = Input(shape=(256, 256, 3))

    def encoder_block(x, filters, apply_batchnorm=True):
        x = Conv2D(filters, (4, 4), strides=2, padding="same", use_bias=False)(x)
        if apply_batchnorm:
            x = BatchNormalization()(x)
        x = LeakyReLU()(x)
        return x

    def decoder_block(x, skip, filters):
        x = Conv2DTranspose(filters, (4, 4), strides=2, padding="same", use_bias=False)(x)
        x = BatchNormalization()(x)
        x = ReLU()(x)
        x = Concatenate()([x, skip])
        return x

    down1 = encoder_block(inputs, 64, apply_batchnorm=False)
    down2 = encoder_block(down1, 128)
    down3 = encoder_block(down2, 256)
    down4 = encoder_block(down3, 512)
    down5 = encoder_block(down4, 512)
    down6 = encoder_block(down5, 512)
    down7 = encoder_block(down6, 512)

    bottleneck = Conv2D(512, (4, 4), strides=2, padding="same", use_bias=False)(down7)
    bottleneck = ReLU()(bottleneck)

    up1 = decoder_block(bottleneck, down7, 512)
    up2 = decoder_block(up1, down6, 512)
    up3 = decoder_block(up2, down5, 512)
    up4 = decoder_block(up3, down4, 512)
    up5 = decoder_block(up4, down3, 256)
    up6 = decoder_block(up5, down2, 128)
    up7 = decoder_block(up6, down1, 64)

    outputs = Conv2DTranspose(3, (4, 4), strides=2, padding="same", activation="tanh")(up7)

    return tf.keras.Model(inputs=inputs, outputs=outputs)

generator = pix2pix_generator()

# Pix2Pix Discriminator
def pix2pix_discriminator():
    input_image = Input(shape=(256, 256, 3))
    target_image = Input(shape=(256, 256, 3))
    x = Concatenate()([input_image, target_image])

    def disc_block(x, filters, apply_batchnorm=True):
        x = Conv2D(filters, (4, 4), strides=2, padding="same", use_bias=False)(x)
        if apply_batchnorm:
            x = BatchNormalization()(x)
        x = LeakyReLU()(x)
        return x

    x = disc_block(x, 64, apply_batchnorm=False)
    x = disc_block(x, 128)
    x = disc_block(x, 256)
    x = disc_block(x, 512)
    x = Conv2D(1, (4, 4), strides=1, padding="same")(x)

    return tf.keras.Model(inputs=[input_image, target_image], outputs=x)

discriminator = pix2pix_discriminator()

# Loss Functions with Label Smoothing
loss_object = tf.keras.losses.BinaryCrossentropy(from_logits=True)

def generator_loss(disc_output, gen_output, target):
    adversarial_loss = loss_object(tf.ones_like(disc_output), disc_output)
    l1_loss = tf.reduce_mean(tf.abs(target - gen_output))
    return adversarial_loss + (100 * l1_loss)

def discriminator_loss(disc_real_output, disc_fake_output):
    real_labels = tf.ones_like(disc_real_output) * 0.9  # Label smoothing
    fake_labels = tf.zeros_like(disc_fake_output) + 0.1  # Label smoothing

    real_loss = loss_object(real_labels, disc_real_output)
    fake_loss = loss_object(fake_labels, disc_fake_output)

    return real_loss + fake_loss

generator_optimizer = tf.keras.optimizers.Adam(0.5e-4, beta_1=0.5)
discriminator_optimizer = tf.keras.optimizers.Adam(1e-4, beta_1=0.5)

# Train Step
@tf.function
def train_step(input_image, target):
    with tf.GradientTape() as gen_tape, tf.GradientTape() as disc_tape:
        gen_output = generator(input_image, training=True)
        disc_real_output = discriminator([input_image, target], training=True)
        disc_fake_output = discriminator([input_image, gen_output], training=True)

        gen_loss = generator_loss(disc_fake_output, gen_output, target)
        disc_loss = discriminator_loss(disc_real_output, disc_fake_output)

    generator_gradients = gen_tape.gradient(gen_loss, generator.trainable_variables)
    discriminator_gradients = disc_tape.gradient(disc_loss, discriminator.trainable_variables)

    generator_optimizer.apply_gradients(zip(generator_gradients, generator.trainable_variables))
    discriminator_optimizer.apply_gradients(zip(discriminator_gradients, discriminator.trainable_variables))

    return gen_loss, disc_loss

